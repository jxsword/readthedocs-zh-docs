msgstr ""

#: ../../upstream/docs/user/commercial/sharing.rst:11
msgid "Sharing a project with contractors or partners."
msgstr ""

#: ../../upstream/docs/user/commercial/sharing.rst:12
msgid "Sharing documentation for your product only to specific customers."
msgstr ""

#: ../../upstream/docs/user/commercial/sharing.rst:13
msgid "Embedding documentation in a SaaS application dashboard."
msgstr ""

