msgstr ""

#: ../../upstream/docs/user/builds.rst:170
msgid "7GB of memory (upgradable)"
msgstr ""

#: ../../upstream/docs/user/builds.rst:171
msgid "Concurrent builds vary based on your pricing plan"
msgstr ""

#: ../../upstream/docs/user/builds.rst:173
msgid ""
"If you are having trouble with your documentation builds, you can reach "
"our support at support@readthedocs.com."
msgstr ""

#: ../../upstream/docs/user/builds.rst:176
msgid "|org_brand|"
msgstr ""

#: ../../upstream/docs/user/builds.rst:178
msgid "15 minutes build time"
msgstr ""

#: ../../upstream/docs/user/builds.rst:179
msgid "7GB of memory"
msgstr ""

#: ../../upstream/docs/user/builds.rst:180
msgid "2 concurrent builds"
msgstr ""

#: ../../upstream/docs/user/builds.rst:181
msgid "5GB of disk storage (soft limit)"
msgstr ""

#: ../../upstream/docs/user/builds.rst:183
msgid ""
"We can increase build time on a per-project basis. Send an email to "
"support@readthedocs.org providing a good reason why your documentation "
"needs more resources."
msgstr ""

#: ../../upstream/docs/user/builds.rst:186
msgid ""
"If your business is hitting build limits hosting documentation on Read "
"the Docs, please consider :doc:`Read the Docs Business "
"</commercial/index>` which has options for additional build resources."
msgstr ""

